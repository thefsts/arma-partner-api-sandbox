# Synthetic/local values only. Never commit production credentials.
ARMA_TO_LAW_SHIELD_HMAC_SECRET=replace-with-local-test-secret
LAW_SHIELD_TO_ARMA_HMAC_SECRET=replace-with-local-test-secret
LAW_SHIELD_INTEGRATION_PROCESSOR_URL=http://localhost:4001/process
LAW_SHIELD_INTEGRATION_PROCESSOR_TOKEN=replace-with-local-test-token
LAW_SHIELD_ARMA_INTEGRATION_DISABLED=false
LAW_SHIELD_GATEWAY_REPLAY_GUARD=enabled
LAW_SHIELD_INTEGRATION_PROCESSOR_TIMEOUT_MS=10000
ARMA_LAW_SHIELD_GATEWAY_URL=http://localhost:4000/api/lawshield/arma
ARMA_LAW_SHIELD_OUTBOUND_DISABLED=false

# PATCHES partner API placeholders
PATCHES_PARTNER_API_BASE_URL=http://localhost:4002/api/partner/v1
PATCHES_PARTNER_CLIENT_ID=arma-sandbox
PATCHES_PARTNER_SECRET=replace-with-local-test-secret
# PATCHES partner API kill switch (true = all routes fail closed; health
# reports the disabled state live, never a cached "available")
PATCHES_PARTNER_API_DISABLED=false

# ARMA PATCHES adapter (Stop Point 5) — ARMA-side outbound kill switch.
# true = the ARMA activation service fails closed (QUARANTINED) BEFORE any
# outbound wire I/O to the PATCHES partner API.
ARMA_PATCHES_OUTBOUND_DISABLED=false
