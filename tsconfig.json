{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": false,
    "types": ["node"],
    "allowJs": false
  },
  "include": ["law-shield/arma/**/*.ts", "patches/**/*.ts"],
  "exclude": ["node_modules"]
}
