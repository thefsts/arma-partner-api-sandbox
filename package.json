{
  "name": "arma-partner-api-sandbox",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Sanitized public integration workspace for ARMA System 360 partner APIs (Law Shield + PATCHES). Synthetic data only.",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "test": "node --test \"law-shield/tests/**/*.test.mjs\" \"patches/tests/**/*.test.mjs\" \"ai-governance/tests/**/*.test.mjs\" \"shared/tests/**/*.test.mjs\" \"simulators/tests/**/*.test.mjs\" \"openapi/tests/**/*.test.mjs\"",
    "test:lawshield": "node --test \"law-shield/tests/**/*.test.mjs\"",
    "test:aigov": "node --test \"ai-governance/tests/**/*.test.mjs\"",
    "test:openapi": "node --test \"openapi/tests/**/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "test:patches": "node --test \"patches/tests/**/*.test.mjs\"",
    "test:shared": "node --test \"shared/tests/**/*.test.mjs\"",
    "test:simulators": "node --test \"simulators/tests/**/*.test.mjs\"",
    "render:openapi-docs": "node scripts/render-openapi-docs.mjs",
    "certify:generate": "node scripts/generate-certification-report.mjs",
    "certify:verify": "node scripts/verify-certification-report.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "convex": "^1.25.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.0"
  }
}
